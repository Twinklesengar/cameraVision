# AegisVision backend environment
# Copy to `backend/.env` and adjust. Unset values fall back to defaults in app/config.py.

# ---- Server ----
HOST=0.0.0.0
PORT=8000
RELOAD=true
LOG_LEVEL=INFO

# ---- AI Copilot (optional - rule-based fallback used when blank) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Camera streams (JSON). `source` can be an int webcam index or an RTSP/MJPEG url.
# Example RTSP:
#   CAMERA_STREAMS={"cam_entrance":{"name":"Main Entrance","source":"rtsp://user:pass@192.168.1.50:554/Streaming/Channels/101","type":"gate"}}

# ---- Face matching ----
FACE_DISTANCE_THRESHOLD=0.60
FACE_CONFIDENCE_MIN=0.65
ANTI_SPOOF_THRESHOLD=0.70

# ---- Tracking / performance ----
TRACK_REEMBED_INTERVAL_SEC=1.5
TRACK_KEEP_SECONDS=4.0
GATE_TRACK_CONFIRM_SEC=1.5

# ---- Analytics ----
IDLE_TIMEOUT_SECONDS=300
PHONE_USAGE_THRESHOLD_SEC=10

# ---- Privacy / retention (keep this FALSE: UNKNOWN faces are never stored) ----
ENABLE_UNKNOWN_SNAPSHOTS=false

# ---- Rule-based escalation ----
RULE_SWEEP_INTERVAL_SEC=30
RULE_WINDOW_MIN=30
UNKNOWN_GATE_COUNT=3
PHONE_OVERUSE_COUNT=3
DROWSINESS_REPEAT_COUNT=3
ESCALATION_DEDUPE_SEC=600

# ---- External push providers (leave blank to disable) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_WEBHOOK_URL=
NOTIFY_MIN_SEVERITY=WARNING

# ---- Auth (Phase 6; change in production) ----
JWT_SECRET=change-me-in-production